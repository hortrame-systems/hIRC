{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:hirc:candidate:discovery-decision:1",
  "title": "hIRC candidate discovery and recommendation-rationale decision",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "decision_id", "state", "request", "candidate_set", "policy", "variation", "result", "explanation", "escape", "authority_effect", "reliability_effect", "holds"],
  "properties": {
    "schema_version": {"const": "hirc.discovery-decision/1-candidate"},
    "decision_id": {"$ref": "#/$defs/stableId"},
    "state": {"enum": ["PROPOSED", "PRESENTED", "HELD", "APPEALED", "SUPERSEDED"]},
    "request": {
      "type": "object", "additionalProperties": false,
      "required": ["participant_ref", "context_ref", "query_ref", "settings_version", "plural_routes_requested", "personalization_enabled", "direct_source_mode_available"],
      "properties": {
        "participant_ref": {"$ref": "#/$defs/stableId"},
        "context_ref": {"$ref": "#/$defs/stableId"},
        "query_ref": {"type": "string", "minLength": 1},
        "settings_version": {"type": "string", "minLength": 1},
        "plural_routes_requested": {"const": true},
        "personalization_enabled": {"type": "boolean"},
        "direct_source_mode_available": {"const": true}
      }
    },
    "candidate_set": {
      "type": "object", "additionalProperties": false,
      "required": ["frozen_at", "input_manifest_sha256", "items"],
      "properties": {
        "frozen_at": {"type": "string", "format": "date-time"},
        "input_manifest_sha256": {"$ref": "#/$defs/sha256"},
        "items": {"type": "array", "items": {"$ref": "#/$defs/candidate"}}
      }
    },
    "policy": {
      "type": "object", "additionalProperties": false,
      "required": ["policy_id", "version", "definition_sha256", "objectives", "source_diversity_required", "engagement_optimization", "agreement_optimization", "minority_suppression_allowed"],
      "properties": {
        "policy_id": {"$ref": "#/$defs/stableId"},
        "version": {"type": "string", "minLength": 1},
        "definition_sha256": {"$ref": "#/$defs/sha256"},
        "objectives": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"enum": ["PARTICIPANT_SELECTED", "RELEVANCE", "RECENCY", "SOURCE_DIVERSITY", "DISSENT_REACHABILITY", "UNCERTAINTY_VISIBILITY"]}},
        "source_diversity_required": {"const": true},
        "engagement_optimization": {"const": false},
        "agreement_optimization": {"const": false},
        "minority_suppression_allowed": {"const": false}
      }
    },
    "variation": {
      "type": "object", "additionalProperties": false,
      "required": ["mode", "independence_claim"],
      "properties": {
        "mode": {"enum": ["DETERMINISTIC", "BOUNDED_RANDOM", "EXTERNAL"]},
        "independence_claim": {"const": false},
        "seed_commitment_ref": {"type": "string", "minLength": 1},
        "replay_ref": {"type": "string", "minLength": 1},
        "external_observation_ref": {"type": "string", "minLength": 1}
      },
      "allOf": [
        {"if": {"properties": {"mode": {"const": "BOUNDED_RANDOM"}}}, "then": {"required": ["seed_commitment_ref", "replay_ref"]}},
        {"if": {"properties": {"mode": {"const": "EXTERNAL"}}}, "then": {"required": ["external_observation_ref"]}}
      ]
    },
    "result": {
      "type": "object", "additionalProperties": false,
      "required": ["items", "exclusions"],
      "properties": {
        "items": {"type": "array", "items": {"$ref": "#/$defs/resultItem"}},
        "exclusions": {"type": "array", "items": {"$ref": "#/$defs/exclusion"}}
      }
    },
    "explanation": {
      "type": "object", "additionalProperties": false,
      "required": ["rationale_available", "exclusions_disclosed", "uncertainty_disclosed", "policy_ref_visible", "appeal_ref", "settings_ref"],
      "properties": {
        "rationale_available": {"const": true},
        "exclusions_disclosed": {"const": true},
        "uncertainty_disclosed": {"const": true},
        "policy_ref_visible": {"const": true},
        "appeal_ref": {"type": "string", "minLength": 1},
        "settings_ref": {"type": "string", "minLength": 1}
      }
    },
    "escape": {
      "type": "object", "additionalProperties": false,
      "required": ["direct_source_retrieval", "permitted_originals_reachable", "dissent_reachable", "disable_ranking_available"],
      "properties": {
        "direct_source_retrieval": {"const": true},
        "permitted_originals_reachable": {"const": true},
        "dissent_reachable": {"const": true},
        "disable_ranking_available": {"const": true}
      }
    },
    "authority_effect": {"const": "NONE"},
    "reliability_effect": {"const": "NONE"},
    "holds": {"type": "array", "items": {"type": "string", "minLength": 1}}
  },
  "allOf": [
    {
      "if": {"properties": {"state": {"const": "HELD"}}},
      "then": {
        "properties": {
          "holds": {"minItems": 1}
        }
      },
      "else": {
        "properties": {
          "candidate_set": {"properties": {"items": {"minItems": 2}}},
          "result": {"properties": {"items": {"minItems": 1}}}
        }
      }
    }
  ],
  "$defs": {
    "stableId": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{0,255}$"},
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "idArray": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
    "candidate": {
      "type": "object", "additionalProperties": false,
      "required": ["artifact_ref", "source_ref", "source_sha256", "source_context_ref", "audience_check", "privacy_check", "route_refs", "minority_or_dissent", "eligible"],
      "properties": {
        "artifact_ref": {"$ref": "#/$defs/stableId"},
        "source_ref": {"type": "string", "minLength": 1},
        "source_sha256": {"$ref": "#/$defs/sha256"},
        "source_context_ref": {"$ref": "#/$defs/stableId"},
        "audience_check": {"const": "PASS"},
        "privacy_check": {"const": "PASS"},
        "route_refs": {"$ref": "#/$defs/idArray"},
        "minority_or_dissent": {"type": "boolean"},
        "eligible": {"const": true}
      }
    },
    "resultItem": {
      "type": "object", "additionalProperties": false,
      "required": ["artifact_ref", "rank", "route_ref", "rationale_refs", "original_ref", "dissent_refs", "uncertainty"],
      "properties": {
        "artifact_ref": {"$ref": "#/$defs/stableId"},
        "rank": {"type": "integer", "minimum": 1},
        "route_ref": {"$ref": "#/$defs/stableId"},
        "rationale_refs": {"$ref": "#/$defs/idArray"},
        "original_ref": {"type": "string", "minLength": 1},
        "dissent_refs": {"$ref": "#/$defs/idArray"},
        "uncertainty": {"type": "string", "minLength": 1}
      }
    },
    "exclusion": {
      "type": "object", "additionalProperties": false,
      "required": ["artifact_ref", "reason", "appealable"],
      "properties": {
        "artifact_ref": {"$ref": "#/$defs/stableId"},
        "reason": {"type": "string", "minLength": 1},
        "appealable": {"const": true}
      }
    }
  }
}
