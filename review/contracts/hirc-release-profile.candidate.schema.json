{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:hirc:candidate:release-profile:1",
  "title": "hIRC candidate enabled release profile",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "profile_id",
    "version",
    "state",
    "acceptance_object",
    "plan_edition_ref",
    "foundation_manifest_sha256",
    "goal_version_ref",
    "source_set_sha256",
    "build_sha256",
    "environment_ref",
    "environment_manifest_sha256",
    "release_authority_ref",
    "release_authority_sha256",
    "assurance_profile_ref",
    "assurance_binding",
    "release_subject_sha256",
    "release_evidence_bundle_sha256",
    "evaluated_at",
    "required_control_ids",
    "required_test_ids",
    "release_evidence_refs",
    "enabled_capabilities",
    "disabled_capabilities",
    "core_controls",
    "tests",
    "residual_refs",
    "recovery_ref"
  ],
  "properties": {
    "schema_version": {"const": "hirc.release-profile/1-candidate"},
    "profile_id": {"$ref": "#/$defs/id"},
    "version": {"type": "string", "minLength": 1},
    "state": {"enum": ["DRAFT", "READY_FOR_RELEASE", "RELEASED", "HELD", "SUPERSEDED"]},
    "acceptance_object": {"const": "ENABLED_PROFILE"},
    "plan_edition_ref": {"type": "string", "minLength": 1},
    "foundation_manifest_sha256": {"$ref": "#/$defs/sha256"},
    "goal_version_ref": {"type": "string", "minLength": 1},
    "source_set_sha256": {"$ref": "#/$defs/sha256"},
    "build_sha256": {"$ref": "#/$defs/sha256"},
    "environment_ref": {"type": "string", "minLength": 1},
    "environment_manifest_sha256": {"$ref": "#/$defs/sha256"},
    "release_authority_ref": {"type": "string", "minLength": 1},
    "release_authority_sha256": {"$ref": "#/$defs/sha256"},
    "assurance_profile_ref": {"type": "string", "minLength": 1},
    "assurance_binding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["profile_sha256", "required_control_set_sha256", "required_test_set_sha256", "resolver_ref", "resolver_sha256", "resolved_at"],
      "properties": {
        "profile_sha256": {"$ref": "#/$defs/sha256"},
        "required_control_set_sha256": {"$ref": "#/$defs/sha256"},
        "required_test_set_sha256": {"$ref": "#/$defs/sha256"},
        "resolver_ref": {"type": "string", "minLength": 1},
        "resolver_sha256": {"$ref": "#/$defs/sha256"},
        "resolved_at": {"$ref": "#/$defs/strictTimestamp"}
      }
    },
    "release_subject_sha256": {"$ref": "#/$defs/sha256"},
    "release_evidence_bundle_sha256": {"$ref": "#/$defs/sha256"},
    "evaluated_at": {"$ref": "#/$defs/strictTimestamp"},
    "required_control_ids": {"$ref": "#/$defs/nonEmptyIdArray"},
    "required_test_ids": {"$ref": "#/$defs/nonEmptyIdArray"},
    "release_evidence_refs": {"$ref": "#/$defs/idArray"},
    "enabled_capabilities": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["capability_id", "route_ref", "effect_ceiling_ref", "control_refs", "test_refs"],
        "properties": {
          "capability_id": {"$ref": "#/$defs/id"},
          "route_ref": {"type": "string", "minLength": 1},
          "effect_ceiling_ref": {"type": "string", "minLength": 1},
          "control_refs": {"$ref": "#/$defs/nonEmptyIdArray"},
          "test_refs": {"$ref": "#/$defs/nonEmptyIdArray"}
        }
      }
    },
    "disabled_capabilities": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["capability_id", "state", "enforcement_refs", "absence_proof", "listener_absence_verified", "scheduler_absence_verified", "credential_absence_verified", "grant_absence_verified"],
        "properties": {
          "capability_id": {"$ref": "#/$defs/id"},
          "state": {"const": "UNAVAILABLE"},
          "enforcement_refs": {"$ref": "#/$defs/nonEmptyIdArray"},
          "absence_proof": {
            "type": "object",
            "additionalProperties": false,
            "required": ["subject_sha256", "verifier_ref", "verifier_sha256", "observed_at", "evidence_refs"],
            "properties": {
              "subject_sha256": {"$ref": "#/$defs/sha256"},
              "verifier_ref": {"type": "string", "minLength": 1},
              "verifier_sha256": {"$ref": "#/$defs/sha256"},
              "observed_at": {"$ref": "#/$defs/strictTimestamp"},
              "evidence_refs": {"$ref": "#/$defs/nonEmptyIdArray"}
            }
          },
          "listener_absence_verified": {"type": "boolean"},
          "scheduler_absence_verified": {"type": "boolean"},
          "credential_absence_verified": {"type": "boolean"},
          "grant_absence_verified": {"type": "boolean"}
        }
      }
    },
    "core_controls": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["control_id", "state", "evidence_refs"],
        "properties": {
          "control_id": {"$ref": "#/$defs/id"},
          "state": {"enum": ["PASS", "FAIL", "HELD", "NOT_VERIFIED"]},
          "evidence_refs": {"$ref": "#/$defs/idArray"}
        }
      }
    },
    "tests": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["test_id", "applicability", "state", "evidence_refs"],
        "properties": {
          "test_id": {"$ref": "#/$defs/id"},
          "applicability": {"enum": ["REQUIRED", "NOT_APPLICABLE"]},
          "state": {"enum": ["PASS", "FAIL", "HELD", "NOT_RUN", "NOT_APPLICABLE"]},
          "evidence_refs": {"$ref": "#/$defs/idArray"}
        },
        "allOf": [
          {
            "if": {"properties": {"applicability": {"const": "NOT_APPLICABLE"}}},
            "then": {"properties": {"state": {"const": "NOT_APPLICABLE"}}}
          }
        ]
      }
    },
    "residual_refs": {"$ref": "#/$defs/idArray"},
    "recovery_ref": {"type": "string", "minLength": 1},
    "observed_release": {
      "type": "object",
      "additionalProperties": false,
      "required": ["intent_sha256", "subject_sha256", "build_sha256", "environment_manifest_sha256", "request_state", "observed_state", "observed_at", "evidence_refs"],
      "properties": {
        "intent_sha256": {"$ref": "#/$defs/sha256"},
        "subject_sha256": {"$ref": "#/$defs/sha256"},
        "build_sha256": {"$ref": "#/$defs/sha256"},
        "environment_manifest_sha256": {"$ref": "#/$defs/sha256"},
        "request_state": {"const": "ACCEPTED_BY_PROVIDER"},
        "observed_state": {"const": "CONFIRMED"},
        "observed_at": {"$ref": "#/$defs/strictTimestamp"},
        "evidence_refs": {"$ref": "#/$defs/nonEmptyIdArray"}
      }
    }
  },
  "allOf": [
    {
      "if": {"properties": {"state": {"enum": ["READY_FOR_RELEASE", "RELEASED"]}}},
      "then": {
        "properties": {
          "release_evidence_refs": {"$ref": "#/$defs/nonEmptyIdArray"},
          "disabled_capabilities": {
            "items": {
              "properties": {
                "listener_absence_verified": {"const": true},
                "scheduler_absence_verified": {"const": true},
                "credential_absence_verified": {"const": true},
                "grant_absence_verified": {"const": true}
              }
            }
          },
          "tests": {
            "items": {
              "if": {"properties": {"applicability": {"const": "REQUIRED"}}},
              "then": {"properties": {"state": {"const": "PASS"}, "evidence_refs": {"$ref": "#/$defs/nonEmptyIdArray"}}}
            }
          },
          "core_controls": {"items": {"properties": {"state": {"const": "PASS"}, "evidence_refs": {"$ref": "#/$defs/nonEmptyIdArray"}}}}
        }
      }
    },
    {
      "if": {"properties": {"state": {"const": "RELEASED"}}, "required": ["state"]},
      "then": {"required": ["observed_release"]}
    }
  ],
  "anyOf": [
    {"properties": {"enabled_capabilities": {"minItems": 1}}},
    {"properties": {"disabled_capabilities": {"minItems": 1}}}
  ],
  "$defs": {
    "id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{0,255}$"},
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "idArray": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
    "nonEmptyIdArray": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
    "strictTimestamp": {"type": "string", "format": "date-time", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]+)?Z$"}
  }
}
