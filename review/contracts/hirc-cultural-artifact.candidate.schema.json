{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:hirc:candidate:cultural-artifact:1",
  "title": "hIRC candidate cultural artifact and provenance record",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "artifact_id",
    "artifact_type",
    "state",
    "created_by",
    "context",
    "source",
    "content_ref",
    "permissions",
    "provenance",
    "interpretations",
    "dissent",
    "related_contexts",
    "authority_effect",
    "cultural_score_effect",
    "recovery",
    "holds"
  ],
  "properties": {
    "schema_version": {"const": "hirc.cultural-artifact/1-candidate"},
    "artifact_id": {"$ref": "#/$defs/stableId"},
    "artifact_type": {"enum": ["STORY", "ART", "RITUAL", "TERM", "DEBATE", "LESSON", "HISTORY", "TRANSLATION", "PROJECT", "OTHER"]},
    "state": {"enum": ["CANDIDATE", "ACTIVE", "CORRECTED", "SUPERSEDED", "WITHDRAWN", "HELD"]},
    "created_by": {"$ref": "#/$defs/idArray"},
    "context": {
      "type": "object",
      "additionalProperties": false,
      "required": ["context_id", "audience_refs", "privacy_class", "purpose_ref", "version"],
      "properties": {
        "context_id": {"$ref": "#/$defs/stableId"},
        "audience_refs": {"$ref": "#/$defs/idArray"},
        "privacy_class": {"enum": ["PUBLIC", "TEAM_SCOPED", "TASK_SCOPED", "PRIVATE", "PROTECTED"]},
        "purpose_ref": {"type": "string", "minLength": 1},
        "version": {"type": "string", "minLength": 1}
      }
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["original_ref", "original_sha256", "source_kind", "source_context_ref", "source_audience_refs", "direct_source_available"],
      "properties": {
        "original_ref": {"type": "string", "minLength": 1},
        "original_sha256": {"$ref": "#/$defs/sha256"},
        "source_kind": {"enum": ["ORIGINAL", "DERIVED", "TRANSLATED", "SYNTHESIS"]},
        "source_context_ref": {"$ref": "#/$defs/stableId"},
        "source_audience_refs": {"$ref": "#/$defs/idArray"},
        "direct_source_available": {"type": "boolean"},
        "non_equivalence_ref": {"type": "string", "minLength": 1}
      }
    },
    "content_ref": {
      "type": "object",
      "additionalProperties": false,
      "required": ["content_sha256", "media_type", "storage_ref", "body_in_record"],
      "properties": {
        "content_sha256": {"$ref": "#/$defs/sha256"},
        "media_type": {"type": "string", "minLength": 1},
        "storage_ref": {"type": "string", "minLength": 1},
        "body_in_record": {"const": false}
      }
    },
    "permissions": {
      "type": "object",
      "additionalProperties": false,
      "required": ["commons_eligible", "disclosure_review", "consent_refs", "allowed_audience_refs", "export_state"],
      "properties": {
        "commons_eligible": {"type": "boolean"},
        "disclosure_review": {"enum": ["PASS", "HELD", "NOT_REQUIRED"]},
        "consent_refs": {"$ref": "#/$defs/idArray"},
        "allowed_audience_refs": {"$ref": "#/$defs/idArray"},
        "export_state": {"enum": ["LOCAL_ONLY", "SAME_TEAM", "AUTHORIZED_EXPORT", "HELD"]}
      }
    },
    "provenance": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/provenanceEvent"}
    },
    "interpretations": {
      "type": "array",
      "items": {"$ref": "#/$defs/interpretation"}
    },
    "dissent": {
      "type": "array",
      "items": {"$ref": "#/$defs/dissent"}
    },
    "correction": {"$ref": "#/$defs/correction"},
    "supersession": {"$ref": "#/$defs/supersession"},
    "related_contexts": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["context_ref", "relation", "inheritance_authorized"],
        "properties": {
          "context_ref": {"$ref": "#/$defs/stableId"},
          "relation": {"enum": ["INFORMED_BY", "TRANSLATED_FROM", "CONTRASTS_WITH", "LOCAL_VARIANT_OF"]},
          "inheritance_authorized": {"const": false}
        }
      }
    },
    "authority_effect": {"const": "NONE"},
    "cultural_score_effect": {"const": "NONE"},
    "recovery": {
      "type": "object",
      "additionalProperties": false,
      "required": ["original_recoverable", "dissent_recoverable", "history_append_only", "recovery_ref"],
      "properties": {
        "original_recoverable": {"const": true},
        "dissent_recoverable": {"const": true},
        "history_append_only": {"const": true},
        "recovery_ref": {"type": "string", "minLength": 1}
      }
    },
    "holds": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["code", "reason", "evidence_refs"],
        "properties": {
          "code": {"$ref": "#/$defs/stableId"},
          "reason": {"type": "string", "minLength": 1},
          "evidence_refs": {"$ref": "#/$defs/idArray"}
        }
      }
    }
  },
  "allOf": [
    {
      "if": {"properties": {"permissions": {"properties": {"commons_eligible": {"const": true}}}}},
      "then": {
        "properties": {
          "context": {"properties": {"privacy_class": {"not": {"const": "PROTECTED"}}}},
          "permissions": {
            "properties": {
              "disclosure_review": {"enum": ["PASS", "NOT_REQUIRED"]},
              "consent_refs": {"minItems": 1}
            }
          }
        }
      }
    },
    {
      "if": {"properties": {"state": {"const": "CORRECTED"}}},
      "then": {"required": ["correction"]}
    },
    {
      "if": {"properties": {"state": {"const": "SUPERSEDED"}}},
      "then": {"required": ["supersession"]}
    }
  ],
  "$defs": {
    "stableId": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{0,255}$"},
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "idArray": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
    "provenanceEvent": {
      "type": "object",
      "additionalProperties": false,
      "required": ["event_id", "event_type", "actor_ref", "observed_at", "basis_refs", "input_sha256_refs", "output_sha256"],
      "properties": {
        "event_id": {"$ref": "#/$defs/stableId"},
        "event_type": {"enum": ["CREATED", "DERIVED", "TRANSLATED", "DISSENT_RECORDED", "CORRECTED", "SUPERSEDED", "WITHDRAWN"]},
        "actor_ref": {"$ref": "#/$defs/stableId"},
        "observed_at": {"type": "string", "format": "date-time"},
        "basis_refs": {"$ref": "#/$defs/idArray"},
        "input_sha256_refs": {"type": "array", "items": {"$ref": "#/$defs/sha256"}, "uniqueItems": true},
        "output_sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "interpretation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["interpretation_id", "author_ref", "claim", "status", "evidence_refs", "counterevidence_refs"],
      "properties": {
        "interpretation_id": {"$ref": "#/$defs/stableId"},
        "author_ref": {"$ref": "#/$defs/stableId"},
        "claim": {"type": "string", "minLength": 1},
        "status": {"enum": ["CANDIDATE", "DISSENT", "ACCEPTED_LOCAL", "SUPERSEDED"]},
        "evidence_refs": {"$ref": "#/$defs/idArray"},
        "counterevidence_refs": {"$ref": "#/$defs/idArray"}
      }
    },
    "dissent": {
      "type": "object",
      "additionalProperties": false,
      "required": ["dissent_id", "participant_ref", "reason_ref", "status", "preserved"],
      "properties": {
        "dissent_id": {"$ref": "#/$defs/stableId"},
        "participant_ref": {"$ref": "#/$defs/stableId"},
        "reason_ref": {"type": "string", "minLength": 1},
        "status": {"enum": ["OPEN", "RESOLVED", "PRESERVED"]},
        "preserved": {"const": true}
      }
    },
    "correction": {
      "type": "object",
      "additionalProperties": false,
      "required": ["predecessor_ref", "predecessor_sha256", "correction_ref", "correction_sha256", "reason_refs", "preserves_predecessor"],
      "properties": {
        "predecessor_ref": {"type": "string", "minLength": 1},
        "predecessor_sha256": {"$ref": "#/$defs/sha256"},
        "correction_ref": {"type": "string", "minLength": 1},
        "correction_sha256": {"$ref": "#/$defs/sha256"},
        "reason_refs": {"$ref": "#/$defs/idArray"},
        "preserves_predecessor": {"const": true}
      }
    },
    "supersession": {
      "type": "object",
      "additionalProperties": false,
      "required": ["predecessor_ref", "successor_ref", "reason_refs", "predecessor_recoverable"],
      "properties": {
        "predecessor_ref": {"type": "string", "minLength": 1},
        "successor_ref": {"type": "string", "minLength": 1},
        "reason_refs": {"$ref": "#/$defs/idArray"},
        "predecessor_recoverable": {"const": true}
      }
    }
  }
}
